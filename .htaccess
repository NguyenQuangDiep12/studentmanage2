# Dùng khi chạy bằng Apache (Laragon): http://my-api.test/
RewriteEngine On

# Giữ header Authorization cho JWT
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Trang gốc -> giao diện đăng nhập
RewriteRule ^$ /app/index.html [R=302,L]

# Toàn bộ /api/* -> public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/ /public/index.php [QSA,L]
